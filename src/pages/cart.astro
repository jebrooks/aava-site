---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
---

<BaseLayout
  title="Your Cart"
  description="Review your charcuterie order and select a Northern Virginia delivery window."
  noindex
>
  <section class="section cart-page">
    <div class="container">
      <div class="section-heading cart-page__heading">
        <p class="eyebrow">Your order</p>
        <h1>Cart</h1>
      </div>

      <div class="cart-layout" data-cart-app>
        <div class="cart-panel">
          <div data-cart-lines aria-live="polite">
            <p>Loading your cart…</p>
          </div>
        </div>

        <aside class="cart-summary">
          <h2>Delivery and checkout</h2>
          <div class="selected-delivery" data-selected-delivery hidden></div>
          <button class="text-button" type="button" data-change-delivery hidden>Change delivery window</button>
          <form class="delivery-form" data-delivery-form hidden>
            <label>
              <span>Delivery ZIP code</span>
              <input name="zip" inputmode="numeric" autocomplete="postal-code" maxlength="10" pattern="[0-9]{5}(-[0-9]{4})?" aria-describedby="delivery-zip-help" required />
            </label>
            <p class="form-help" id="delivery-zip-help">
              ZIP code not accepted? Call {site.name} at <a href={site.phoneHref}>{site.phoneDisplay}</a> to ask about delivery.
            </p>
            <div class="tour-calendar delivery-calendar" data-delivery-calendar hidden>
              <div class="tour-calendar__nav">
                <button type="button" class="tour-calendar__arrow" data-delivery-previous aria-label="Previous delivery month">←</button>
                <h3 id="delivery-calendar-month" data-delivery-month tabindex="-1">Delivery date</h3>
                <button type="button" class="tour-calendar__arrow" data-delivery-next aria-label="Next delivery month">→</button>
              </div>
              <table aria-labelledby="delivery-calendar-month">
                <thead><tr>{['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'].map(day => <th scope="col">{day}</th>)}</tr></thead>
                <tbody data-delivery-days></tbody>
              </table>
              <p class="tour-calendar__legend"><span aria-hidden="true"></span>Available <span class="tour-calendar__selected-key" aria-hidden="true"></span>Selected · Eastern Time</p>
            </div>
            <label data-slot-field hidden>
              <span data-delivery-time-label>Delivery time</span>
              <select name="slot" data-slot-select required></select>
            </label>
            <p class="form-status" data-delivery-status role="status"></p>
          </form>

          <dl class="cart-totals">
            <div><dt>Subtotal</dt><dd data-subtotal>—</dd></div>
            <div><dt>Total before delivery/tax</dt><dd data-total>—</dd></div>
          </dl>
          <p class="cart-summary__note">Delivery fees, discounts, and applicable taxes are calculated securely by Shopify.</p>
          <button class="button button--primary checkout-button" type="button" data-checkout disabled>
            Continue to secure checkout
          </button>
          <p class="form-status" data-cart-status role="status"></p>
        </aside>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import type { DeliverySlot, ShopifyCart, CartLine } from '../lib/shopify/types';
  import { servingCount } from '../lib/serving-size';
  import { deliveryCalendarMonth } from '../lib/delivery-calendar';
  import { CART_ID_KEY, CART_COUNT_KEY, CART_CHECKOUT_KEY, customerCartQuantity, isMissingCartResponse, loadStoredCart, markCartCheckout } from '../lib/cart-session';

  const linesRoot = document.querySelector<HTMLElement>('[data-cart-lines]');
  const subtotal = document.querySelector<HTMLElement>('[data-subtotal]');
  const total = document.querySelector<HTMLElement>('[data-total]');
  const checkout = document.querySelector<HTMLButtonElement>('[data-checkout]');
  const cartStatus = document.querySelector<HTMLElement>('[data-cart-status]');
  const deliveryForm = document.querySelector<HTMLFormElement>('[data-delivery-form]');
  const zipInput = deliveryForm?.elements.namedItem('zip') as HTMLInputElement | null;
  const slotField = document.querySelector<HTMLElement>('[data-slot-field]');
  const slotSelect = document.querySelector<HTMLSelectElement>('[data-slot-select]');
  const deliveryStatus = document.querySelector<HTMLElement>('[data-delivery-status]');
  const selectedDelivery = document.querySelector<HTMLElement>('[data-selected-delivery]');
  const changeDelivery = document.querySelector<HTMLButtonElement>('[data-change-delivery]');
  let currentCart: ShopifyCart | null = null;
  const deliveryCalendar = document.querySelector<HTMLElement>('[data-delivery-calendar]');
  const deliveryMonth = document.querySelector<HTMLElement>('[data-delivery-month]');
  const deliveryDays = document.querySelector<HTMLElement>('[data-delivery-days]');
  const previousMonth = document.querySelector<HTMLButtonElement>('[data-delivery-previous]');
  const nextMonth = document.querySelector<HTMLButtonElement>('[data-delivery-next]');
  const timeLabel = document.querySelector<HTMLElement>('[data-delivery-time-label]');
  let deliverySlots: DeliverySlot[] = [];
  let calendarMonth = '';
  let selectedDate = '';
  let savingDelivery = false;

  function renderDeliveryCalendar() {
    if (!deliveryDays || !deliveryMonth || !calendarMonth) return;
    const calendar = deliveryCalendarMonth(deliverySlots, calendarMonth, selectedDate);
    deliveryMonth.textContent = calendar.label;
    if (previousMonth) previousMonth.disabled = savingDelivery || !calendar.hasPrevious;
    if (nextMonth) nextMonth.disabled = savingDelivery || !calendar.hasNext;
    deliveryDays.replaceChildren();
    let row = document.createElement('tr');
    calendar.days.forEach((day, index) => {
      if (index && index % 7 === 0) {
        deliveryDays.append(row);
        row = document.createElement('tr');
      }
      const cell = document.createElement('td');
      if (day) {
        const button = document.createElement('button');
        button.type = 'button';
        button.textContent = String(Number(day.date.slice(-2)));
        button.dataset.date = day.date;
        button.disabled = savingDelivery || !day.available;
        button.setAttribute('aria-pressed', String(day.selected));
        button.setAttribute('aria-label', `${day.date} — ${day.available ? 'delivery available' : 'unavailable'}`);
        button.addEventListener('click', () => {
          selectedDate = day.date;
          renderDeliveryCalendar();
          renderDeliveryTimes();
          deliveryDays.querySelector<HTMLButtonElement>(`[data-date="${day.date}"]`)?.focus();
        });
        cell.append(button);
      }
      row.append(cell);
    });
    deliveryDays.append(row);
  }

  function renderDeliveryTimes() {
    if (!slotSelect) return;
    const placeholder = document.createElement('option');
    placeholder.value = '';
    placeholder.textContent = 'Choose a delivery time';
    placeholder.disabled = true;
    placeholder.selected = true;
    slotSelect.replaceChildren(placeholder);
    deliverySlots.filter(slot => slot.date === selectedDate && slot.available).forEach(slot => {
      const option = document.createElement('option');
      option.value = slot.key;
      option.textContent = slot.label;
      slotSelect.append(option);
    });
    if (slotField) slotField.hidden = false;
    if (timeLabel) timeLabel.textContent = `Delivery time for ${selectedDate}`;
    if (deliveryStatus) deliveryStatus.textContent = 'Choose a time to save your delivery window.';
  }

  for (const [button, direction] of [[previousMonth, -1], [nextMonth, 1]] as const) {
    button?.addEventListener('click', () => {
      const [year, month] = calendarMonth.split('-').map(Number);
      calendarMonth = new Date(Date.UTC(year, month - 1 + direction, 1)).toISOString().slice(0, 7);
      renderDeliveryCalendar();
      deliveryMonth?.focus();
    });
  }

  zipInput?.addEventListener('input', () => {
    if (zipInput.validity.valid && slotSelect?.value) void saveDeliveryWindow();
  });

  const money = (value: { amount: string; currencyCode: string }) =>
    new Intl.NumberFormat('en-US', { style: 'currency', currency: value.currencyCode })
      .format(Number(value.amount));
  const isDeliveryLine = (line: CartLine) =>
    line.merchandise.product.handle.startsWith('delivery-slot-');

  function element<K extends keyof HTMLElementTagNameMap>(tag: K, className?: string) {
    const node = document.createElement(tag);
    if (className) node.className = className;
    return node;
  }

  async function cartRequest(body: Record<string, unknown>) {
    const response = await fetch('/api/cart', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(body),
    });
    const result = await response.json();
    if (isMissingCartResponse(response, result)) return null;
    if (!response.ok) throw new Error(result.error || 'The cart could not be updated.');
    return result.cart as ShopifyCart;
  }

  function renderLine(line: CartLine) {
    const row = element('article', 'cart-line');
    if (line.merchandise.image) {
      const image = element('img');
      image.src = line.merchandise.image.url;
      image.alt = line.merchandise.image.altText || line.merchandise.product.title;
      image.width = 180;
      image.height = 180;
      row.append(image);
    }
    const content = element('div', 'cart-line__content');
    const title = element('h3');
    const link = element('a');
    link.href = `/charcuterie-menu/p/${line.merchandise.product.handle}`;
    link.textContent = line.merchandise.product.title;
    title.append(link);
    const heading = element('div', 'cart-line__heading');
    const price = element('p', 'cart-line__price');
    price.textContent = money(line.cost.totalAmount);
    heading.append(title, price);
    content.append(heading);
    const count = servingCount(line.merchandise.product, line.merchandise);
    if (count) {
      const servings = element('p', 'cart-line__selection');
      servings.textContent = `Serves: ${count}`;
      content.append(servings);
    }
    if (line.merchandise.title !== 'Default Title') {
      const variant = element('p', 'cart-line__variant');
      variant.textContent = line.merchandise.title;
      content.append(variant);
    }
    for (const attribute of line.attributes.filter(attribute =>
      ['Board preference', 'Cheeses', 'Meats', 'Accompaniments', 'Recipient email', 'Recipient name', 'Message', 'Send on'].includes(attribute.key)
    )) {
      const detail = element('p', 'cart-line__selection');
      const label = element('strong');
      label.textContent = `${attribute.key}: `;
      detail.append(label, document.createTextNode(attribute.value));
      content.append(detail);
    }
    if (line.merchandise.product.isGiftCard) {
      const delivery = element('p', 'cart-line__selection');
      const recipient = line.attributes.find(attribute => attribute.key === 'Recipient email');
      const scheduled = line.attributes.some(attribute => attribute.key === 'Send on');
      delivery.textContent = !recipient ? 'Sent to your checkout email after purchase.'
        : scheduled ? 'Scheduled email delivery, approximately 4–10 a.m. in your timezone.'
        : 'Emailed to the recipient after purchase.';
      const edit = element('a');
      edit.href = `/charcuterie-menu/p/${line.merchandise.product.handle}`;
      edit.textContent = 'To change the recipient or date, remove this card and add it again.';
      content.append(delivery, edit);
    }
    const controls = element('div', 'cart-line__controls');
    const label = element('label');
    label.textContent = 'Quantity ';
    const input = element('input');
    input.type = 'number';
    input.min = '0';
    input.max = '50';
    input.value = String(line.quantity);
    input.inputMode = 'numeric';
    input.addEventListener('change', async () => {
      try {
        input.disabled = true;
        renderCart(await cartRequest({
          action: 'update', cartId: currentCart?.id, lineId: line.id, quantity: Number(input.value),
        }));
      } catch (error) {
        if (cartStatus) cartStatus.textContent = error instanceof Error ? error.message : 'Update failed.';
        input.disabled = false;
      }
    });
    label.append(input);
    const remove = element('button', 'text-button');
    remove.type = 'button';
    remove.textContent = 'Remove';
    const lineStatus = element('p', 'form-status');
    lineStatus.setAttribute('role', 'status');
    remove.addEventListener('click', async () => {
      remove.disabled = true;
      input.disabled = true;
      remove.textContent = 'Removing…';
      lineStatus.textContent = '';
      try {
        renderCart(await cartRequest({ action: 'remove', cartId: currentCart?.id, lineId: line.id }));
      } catch (error) {
        lineStatus.textContent = error instanceof Error ? error.message : 'Remove failed. Please try again.';
        remove.disabled = false;
        input.disabled = false;
        remove.textContent = 'Remove';
      }
    });
    controls.append(label, remove);
    content.append(controls, lineStatus);
    row.append(content);
    return row;
  }

  function renderCart(value: ShopifyCart | null, { openingCheckout = false } = {}) {
    const cart = value || {
      id: '', checkoutUrl: '', totalQuantity: 0, attributes: [], lines: { nodes: [] },
      cost: {
        subtotalAmount: { amount: '0', currencyCode: 'USD' },
        totalAmount: { amount: '0', currencyCode: 'USD' },
      },
    };
    currentCart = cart;
    if (cart.id) localStorage.setItem(CART_ID_KEY, cart.id);
    else localStorage.removeItem(CART_ID_KEY);
    const quantity = customerCartQuantity(cart);
    localStorage.setItem(CART_COUNT_KEY, String(quantity));
    window.dispatchEvent(new CustomEvent('aava:cart-updated', { detail: { ...cart, totalQuantity: quantity } }));
    linesRoot?.replaceChildren();
    const customerLines = cart.lines.nodes.filter((line) => !isDeliveryLine(line));
    const needsDelivery = customerLines.some((line) => line.merchandise.requiresShipping);
    if (!customerLines.length) {
      const empty = element('div', 'empty-cart');
      const heading = element('h2');
      heading.textContent = 'Your cart is empty.';
      const link = element('a', 'button button--primary');
      link.href = '/charcuterie-menu';
      link.textContent = 'Browse the menu';
      empty.append(heading, link);
      linesRoot?.append(empty);
    } else {
      customerLines.forEach((line) => linesRoot?.append(renderLine(line)));
    }
    if (subtotal) subtotal.textContent = money(cart.cost.subtotalAmount);
    if (total) total.textContent = money(cart.cost.totalAmount);

    const attrs = Object.fromEntries(cart.attributes.map((attribute) => [attribute.key, attribute.value]));
    const locked = attrs['Checkout locked'] === 'true';
    const hasSavedWindow = Boolean(attrs['Delivery ZIP'] && attrs['Delivery slot key'] && attrs['Delivery date'] && attrs['Delivery window']);
    if (deliveryForm) deliveryForm.hidden = !needsDelivery || hasSavedWindow;
    if (changeDelivery) {
      changeDelivery.hidden = !needsDelivery || !hasSavedWindow;
      changeDelivery.textContent = 'Change delivery window';
    }
    if (slotField) slotField.hidden = true;
    if (deliveryCalendar) deliveryCalendar.hidden = true;
    if (deliveryStatus) deliveryStatus.textContent = '';
    if (hasSavedWindow && selectedDelivery && needsDelivery) {
      selectedDelivery.hidden = false;
      selectedDelivery.replaceChildren();
      const label = element('strong');
      label.textContent = 'Selected delivery window';
      const detail = element('p');
      detail.textContent = `${attrs['Delivery date'] || ''} · ${attrs['Delivery window'] || ''} · ZIP ${attrs['Delivery ZIP'] || ''}`;
      selectedDelivery.append(label, detail);
      if (zipInput && attrs['Delivery ZIP']) zipInput.value = attrs['Delivery ZIP'];
    } else if (selectedDelivery) {
      selectedDelivery.hidden = true;
    }
    if (checkout) {
      checkout.textContent = openingCheckout ? 'Opening secure checkout…' : locked ? 'Resume checkout' : 'Continue to secure checkout';
      checkout.disabled = openingCheckout || !customerLines.length ||
        (needsDelivery && !hasSavedWindow);
    }
    if (cartStatus) cartStatus.textContent = openingCheckout
      ? 'Opening secure checkout…'
      : customerLines.length && needsDelivery && !hasSavedWindow
      ? 'Choose a delivery window before checkout.'
      : locked && customerLines.length
        ? 'Your checkout is ready to resume. Your saved delivery window will be checked again before continuing.'
        : hasSavedWindow && needsDelivery
          ? 'Your delivery window is saved. Continue to checkout when you’re ready.'
          : '';
  }

  async function loadCart() {
    try {
      renderCart(await loadStoredCart(localStorage));
    } catch (error) {
      currentCart = null;
      for (const section of [deliveryForm, selectedDelivery, changeDelivery, deliveryCalendar, slotField]) {
        if (section) section.hidden = true;
      }
      if (checkout) checkout.disabled = true;
      if (subtotal) subtotal.textContent = '—';
      if (total) total.textContent = '—';
      if (cartStatus) cartStatus.textContent = '';
      const message = element('p');
      message.textContent = error instanceof Error ? error.message : 'Could not load the cart.';
      const retry = element('button', 'button button--primary');
      retry.type = 'button';
      retry.textContent = 'Try again';
      retry.addEventListener('click', () => { void initializeCart(); });
      linesRoot?.replaceChildren(message, retry);
    }
  }

  changeDelivery?.addEventListener('click', () => {
    if (!deliveryForm) return;
    deliveryForm.hidden = !deliveryForm.hidden;
    changeDelivery.textContent = deliveryForm.hidden ? 'Change delivery window' : 'Keep saved window';
    if (!deliveryForm.hidden) void loadDeliveryCalendar();
  });

  async function loadDeliveryCalendar() {
    if (deliveryStatus) deliveryStatus.textContent = 'Loading available delivery dates…';
    if (slotField) slotField.hidden = true;
    if (deliveryCalendar) deliveryCalendar.hidden = true;
    deliverySlots = [];
    selectedDate = '';
    try {
      const response = await fetch('/api/delivery/availability?calendar=1');
      const result = await response.json() as { slots?: DeliverySlot[]; error?: string };
      if (!response.ok) throw new Error(result.error || 'Availability could not be loaded.');
      const open = (result.slots || []).filter(slot => slot.available);
      if (!open.length) throw new Error('No delivery dates are currently available.');
      deliverySlots = open;
      const savedDate = currentCart?.attributes.find(attribute => attribute.key === 'Delivery date')?.value;
      calendarMonth = (open.find(slot => slot.date === savedDate)?.date || open[0].date).slice(0, 7);
      renderDeliveryCalendar();
      if (deliveryCalendar) deliveryCalendar.hidden = false;
      if (deliveryStatus) deliveryStatus.textContent = 'Choose a delivery date, then a time.';
    } catch (error) {
      if (deliveryStatus) deliveryStatus.textContent = error instanceof Error ? error.message : 'Availability failed. Reload the page to retry.';
    }
  }

  deliveryForm?.addEventListener('submit', (event) => {
    event.preventDefault();
    void saveDeliveryWindow();
  });

  slotSelect?.addEventListener('change', () => { void saveDeliveryWindow(); });

  async function saveDeliveryWindow() {
    if (savingDelivery || !currentCart?.id || !slotSelect?.value) return;
    if (!zipInput?.validity.valid) {
      if (deliveryStatus) deliveryStatus.textContent = 'Enter your delivery ZIP code to save this window.';
      return;
    }
    const checkoutWasDisabled = checkout?.disabled ?? true;
    savingDelivery = true;
    renderDeliveryCalendar();
    slotSelect.disabled = true;
    if (zipInput) zipInput.disabled = true;
    if (changeDelivery) changeDelivery.disabled = true;
    if (checkout) checkout.disabled = true;
    if (deliveryStatus) deliveryStatus.textContent = 'Saving your delivery window…';
    try {
      const cart = await cartRequest({
        action: 'setDelivery',
        cartId: currentCart.id,
        zip: zipInput?.value,
        slotKey: slotSelect.value,
      });
      renderCart(cart);
      if (!cart) return;
      if (deliveryStatus) deliveryStatus.textContent = 'Delivery window added to your order.';
    } catch (error) {
      if (deliveryStatus) deliveryStatus.textContent = error instanceof Error ? error.message : 'Delivery selection failed.';
      slotSelect.value = '';
      if (checkout) checkout.disabled = checkoutWasDisabled;
    } finally {
      savingDelivery = false;
      renderDeliveryCalendar();
      slotSelect.disabled = false;
      if (zipInput) zipInput.disabled = false;
      if (changeDelivery) changeDelivery.disabled = false;
    }
  }

  checkout?.addEventListener('click', () => {
    if (!currentCart?.id) return;
    checkout.disabled = true;
    if (cartStatus) cartStatus.textContent = 'Validating your cart…';
    fetch('/api/cart', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ action: 'checkout', cartId: currentCart.id }),
    })
      .then(async (response) => {
        const result = await response.json();
        if (isMissingCartResponse(response, result)) {
          renderCart(null);
          return;
        }
        if (!response.ok) throw new Error(result.error || 'Checkout is not ready.');
        renderCart(result.cart, { openingCheckout: true });
        markCartCheckout(localStorage, result.cart.id);
        window.location.assign(result.checkoutUrl);
      })
      .catch((error) => {
        if (cartStatus) cartStatus.textContent = error instanceof Error ? error.message : 'Checkout is not ready.';
        checkout.disabled = false;
      });
  });

  window.addEventListener('pageshow', event => {
    if (event.persisted) void initializeCart();
  });
  document.addEventListener('visibilitychange', () => {
    if (document.visibilityState === 'visible' && localStorage.getItem(CART_CHECKOUT_KEY)) void initializeCart();
  });
  let initializingCart: Promise<void> | undefined;
  function initializeCart(): Promise<void> {
    if (initializingCart) return initializingCart;
    initializingCart = (async () => {
      await loadCart();
      if (deliveryForm && !deliveryForm.hidden) await loadDeliveryCalendar();
    })().finally(() => { initializingCart = undefined; });
    return initializingCart;
  }
  void initializeCart();
</script>
