---
import InquiryPage from '../components/InquiryPage.astro';
import { isShopifyConfigured } from '../lib/shopify/config';
import { listCharcuterieProducts } from '../lib/shopify/storefront';
export const prerender = false;

if (isShopifyConfigured()) {
  try {
    const giftCard = (await listCharcuterieProducts()).products.nodes.find((product) => product.isGiftCard);
    if (giftCard) return Astro.redirect(`/charcuterie-menu/p/${giftCard.handle}`, 302);
  } catch (error) {
    console.error('Unable to load Shopify gift cards.', error);
  }
}
---
<InquiryPage title="Gift cards for wine tours & charcuterie" description="Online gift cards are temporarily unavailable. Get in touch and we’ll help arrange your gift." topic="Something else" prompt="Tell us you’d like to arrange a gift card for wine tours or charcuterie and your preferred amount.">
  <p>Gift cards work for both wine tours and charcuterie orders. Tell us what you have in mind and we’ll help arrange your gift.</p>
</InquiryPage>
