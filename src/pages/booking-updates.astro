---
import CancellationNotice from '../components/CancellationNotice.astro';
import InquiryPage from '../components/InquiryPage.astro';
export const prerender = false;
---
<InquiryPage title="Help with your booking" description="Call to cancel a tour reservation or charcuterie order. Use the form for other questions or change requests." topic="Existing booking or order" prompt="Include your booking or order reference, scheduled date, and the change or question you’d like us to help with.">
  <CancellationNotice />
  <p>For other booking questions or change requests, use the form below. Submitting this form or sending an email does not cancel your reservation or order.</p>
</InquiryPage>
