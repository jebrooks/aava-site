---
interface Props {
  image: string;
  title: string;
  eyebrow?: string;
  description?: string;
  compact?: boolean;
  position?: string;
}

const {
  image,
  title,
  eyebrow,
  description,
  compact = false,
  position = 'center',
} = Astro.props;
---

<section
  class:list={['page-hero', compact && 'page-hero--compact']}
  style={`--hero-image: url('${image}'); --hero-position: ${position};`}
>
  <div class="page-hero__overlay"></div>
  <div class="page-hero__content container">
    {eyebrow && <p class="eyebrow eyebrow--light">{eyebrow}</p>}
    <h1>{title}</h1>
    {description && <p>{description}</p>}
    <slot />
  </div>
</section>
