---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from './PageHero.astro';
import ContactForm from './ContactForm.astro';
interface Props { title: string; description: string; topic: string; prompt: string; }
const { title, description, topic, prompt } = Astro.props;
---
<BaseLayout title={title} description={description}>
  <PageHero image="/images/hero-experiences.webp" title={title} description={description} compact />
  <section class="section section--cream">
    <div class="container--narrow">
      <slot />
      <ContactForm topic={topic} prompt={prompt} />
    </div>
  </section>
</BaseLayout>
