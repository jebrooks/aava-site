---
import { formatMoney } from '../lib/shopify/storefront';
import type { ShopifyProduct } from '../lib/shopify/types';
import { DEFAULT_PRODUCT_IMAGE } from '../lib/product-image';

interface Props {
  product: ShopifyProduct;
}

const { product } = Astro.props;
const firstVariant = product.variants.nodes[0];
const image = product.featuredImage;
const imageSrc = image?.url || DEFAULT_PRODUCT_IMAGE.src;
const imageAlt = image?.altText || (image ? product.title : DEFAULT_PRODUCT_IMAGE.alt);
const imageWidth = image?.width || DEFAULT_PRODUCT_IMAGE.width;
const imageHeight = image?.height || DEFAULT_PRODUCT_IMAGE.height;
---

<a class="product-card" href={`/charcuterie-menu/p/${product.handle}`}>
  <div class="product-card__media">
    <img
      src={imageSrc}
      alt={imageAlt}
      width={imageWidth}
      height={imageHeight}
      loading="lazy"
    />
  </div>
  <div class="product-card__body">
    <h3>{product.title}</h3>
    <p class="product-card__price">
      {firstVariant ? `From ${formatMoney(firstVariant.price)}` : 'View board'}
    </p>
    {!product.availableForSale && <p class="stock-status">Currently unavailable</p>}
  </div>
</a>
