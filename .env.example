# Optional: replace with a hosted form endpoint before production cutover.
# PUBLIC_CONTACT_FORM_ENDPOINT=https://example.com/forms/contact

# Keep legacy checkout links here during the staged Squarespace migration.
PUBLIC_LEGACY_SITE_URL=https://www.allaboardva.com

# Headless Shopify storefront. Use the permanent myshopify.com domain.
PUBLIC_SHOPIFY_STORE_DOMAIN=all-aboard-va.myshopify.com
SHOPIFY_STOREFRONT_ACCESS_TOKEN=
SHOPIFY_API_VERSION=2026-07
SHOPIFY_CHARCUTERIE_COLLECTION_HANDLE=charcuterie

# Server-only Shopify Dev Dashboard app credentials. Never prefix these with PUBLIC_.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# Optional legacy fallback. Dev Dashboard apps exchange the credentials above for 24-hour tokens.
SHOPIFY_ADMIN_ACCESS_TOKEN=
SHOPIFY_WEBHOOK_SECRET=
SHOPIFY_DELIVERY_LOCATION_ID=gid://shopify/Location/0000000000
SHOPIFY_STOREFRONT_PUBLICATION_ID=gid://shopify/Publication/0000000000
SHOPIFY_CHARCUTERIE_COLLECTION_ID=gid://shopify/Collection/0000000000

# Protect the materialization endpoint and custom-board form.
CRON_SECRET=
TURNSTILE_SECRET_KEY=
PUBLIC_TURNSTILE_SITE_KEY=

# Optional local fallback while the delivery_schedule/default Shopify metaobject is being created.
# Keep this value on one line. Sunday is 0, Saturday is 6.
DELIVERY_SCHEDULE_JSON={"timezone":"America/New_York","eligibleZips":["22201"],"dailyCapacity":3,"leadTimeHours":24,"horizonDays":60,"blackoutDates":[],"weeklyWindows":{"1":[{"label":"9:00–11:00 AM","start":"09:00","end":"11:00"}]}}
