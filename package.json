  },
  "dependencies": {
    "@astrojs/vercel": "11.0.5",
    "@fontsource-variable/montserrat": "5.3.0",
    "@fontsource/marcellus": "5.3.0",
    "astro": "7.2.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@types/node": "^26.2.0",
    "typescript": "6.0.3"
  },
  "overrides": {
    "path-to-regexp": "6.3.0"
  }
}
