{
  "name": "all-aboard-va",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "build": "ASTRO_TELEMETRY_DISABLED=1 astro check && ASTRO_TELEMETRY_DISABLED=1 astro build",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview",
    "check": "ASTRO_TELEMETRY_DISABLED=1 astro check",
    "check:catalog": "node scripts/check-catalog-parity.mjs",
    "shopify:setup": "node --env-file=.env scripts/shopify/setup.mjs",
    "shopify:normalize": "node scripts/shopify/normalize-squarespace.mjs",
    "shopify:import": "node --env-file=.env scripts/shopify/import-catalog.mjs",
    "test:cart": "node --experimental-strip-types --test tests/cart-edit.test.mjs",
    "test:boards": "node --experimental-strip-types --test tests/board-customization.test.mjs",
    "test:announcement": "node --experimental-strip-types --test tests/announcement.test.mjs tests/rich-text.test.mjs",
    "shopify:setup-announcement": "node --env-file=.env scripts/shopify/setup-announcement.mjs",
    "shopify:setup-tours": "node --env-file=.env scripts/shopify/setup-tours.mjs",
    "shopify:sync-tours": "node --env-file=.env --experimental-strip-types scripts/shopify/sync-tours.mjs",
    "test:tours": "node --experimental-strip-types --test tests/tour-schedule.test.mjs tests/tour-sync.test.mjs",
    "test:booking": "node --experimental-strip-types --test tests/tour-booking.test.mjs tests/tour-board-sync.test.mjs",
    "shopify:sync-tour-boards": "node --env-file=.env --experimental-strip-types scripts/shopify/sync-tour-boards.mjs",
    "shopify:register-tour-webhooks": "node --env-file=.env scripts/shopify/register-tour-board-webhooks.mjs"
  },
  "dependencies": {
    "@astrojs/vercel": "11.0.5",
    "@fontsource-variable/montserrat": "5.3.0",
    "@fontsource/marcellus": "5.3.0",
    "@vercel/functions": "3.9.1",
    "astro": "7.2.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@types/node": "^26.2.0",
    "typescript": "6.0.3"
  },
  "overrides": {
    "path-to-regexp": "6.3.0"
  }
}
